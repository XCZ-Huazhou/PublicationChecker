{
  "manifest_version": 3,
  "name": "PublicationChecker 期刊分区查询",
  "version": "0.1.0",
  "description": "浏览网页时选中完整期刊名并右键，当前页即可查 JCR / 中科院 / 新锐分区与影响因子，无需另开查询网站。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PublicationChecker 期刊分区查询",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["contextMenus", "scripting", "activeTab", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": [
        "data/journals.json.gz",
        "results.html",
        "content.js",
        "lib/search-core.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
